# Mewsie environment template.
# Copy to `.env` and fill real values. Never commit `.env`.

# ─── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                # Claude API key (https://console.anthropic.com)
PORT=3005                         # HTTP port the Hono server binds to

# Comma-separated list of allowed CORS origins (production domains).
# Localhost is auto-allowed and does not need to be listed here.
ALLOWED_ORIGINS=https://app.omniboost.com,https://mewsie.omniboost.com

# ─── Analytics DB (Supabase) ─────────────────────────────────────────────────
ENABLE_DB_WRITES=true             # set to false to disable all DB writes
SUPABASE_URL=
SUPABASE_SERVICE_KEY=             # service-role key (server-side only)

# ─── Scraper (only needed when running `npm run sync`) ───────────────────────
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=
CONFLUENCE_BASE_URL=
FIRECRAWL_API_KEY=
